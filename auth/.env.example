# Geekhonize Auth 服务配置（复制为 .env 或 export）
# MySQL/MariaDB 连接
GEO_DATABASE_URL=mysql://geekhonize:CHANGE_ME@127.0.0.1:3306/geekhonize
# JWT 签名密钥（>=32 字符随机串）
GEO_JWT_SECRET=please-change-to-a-long-random-string-000000
# 允许的应用白名单（逗号分隔，跨作品通用账号）
GEO_APPS=breakfront,geekhonize-portal,sxsm
# 监听端口（生产经 openresty 反代，仅本机监听）
GEO_PORT=8787
# 令牌有效期秒（默认 7 天）
GEO_TOKEN_TTL=604800
